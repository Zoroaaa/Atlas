{
  "name": "atlas-desktop",
  "version": "1.8.0",
  "private": true,
  "description": "Atlas 桌面客户端",
  "author": "Atlas",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "check-version": "node scripts/check-version.mjs",
    "dist": "npm run check-version && electron-builder --win nsis"
  },
  "build": {
    "appId": "uk.wort.atlas",
    "productName": "Atlas",
    "copyright": "Atlas",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "Atlas-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atlas",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
