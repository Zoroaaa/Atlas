{
  "appId": "uk.wort.atlas",
  "appName": "Atlas",
  "webDir": "../frontend/dist",
  "server": {
    "url": "https://atlas.wort.uk",
    "cleartext": false,
    "allowNavigation": [
      "atlas.wort.uk",
      "*.atlas.wort.uk"
    ]
  },
  "android": {
    "backgroundColor": "#0a0a0b",
    "allowMixedContent": false,
    "appendUserAgent": "AtlasApp/1.8.0"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0b",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0b",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
